<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="gorgosValeria.komandapage"
             Background="{DynamicResource Bg}">

	<ScrollViewer>
		<StackPanel Margin="24" Spacing="18">
			<TextBlock Text="Команда" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource Text}"/>

			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBox Watermark="Поиск участников..."/>
				<Button Grid.Column="1" Content="+ Добавить участника"
                        Background="{DynamicResource Accent}" Foreground="White"
                        Padding="16,10" CornerRadius="6"/>
			</Grid>

			<Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
				<Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
					<StackPanel Spacing="8">
						<TextBlock Text="Участники" Foreground="{DynamicResource Gray}"/>
						<TextBlock Text="8" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource Text}"/>
					</StackPanel>
				</Border>
				<Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
					<StackPanel Spacing="8">
						<TextBlock Text="Администраторы" Foreground="{DynamicResource Gray}"/>
						<TextBlock Text="2" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource Text}"/>
					</StackPanel>
				</Border>
				<Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
					<StackPanel Spacing="8">
						<TextBlock Text="Активные" Foreground="{DynamicResource Gray}"/>
						<TextBlock Text="6" FontSize="26" FontWeight="Bold" Foreground="#55AE83"/>
					</StackPanel>
				</Border>
			</Grid>

			<Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
				<StackPanel Spacing="12">
					<TextBlock Text="Участники команды" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource Text}"/>

					<Border Background="{DynamicResource Task}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="6" Padding="12">
						<Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
							<Border Width="40" Height="40" Background="{DynamicResource Soft}" CornerRadius="20">
								<TextBlock Text="АК" Foreground="{DynamicResource Accent}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
								<TextBlock Text="Александр Козлов" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}"/>
								<TextBlock Text="Руководитель проекта" FontSize="12"
                                           Foreground="{DynamicResource Gray}"/>
							</StackPanel>
							<TextBlock Grid.Column="2" Text="Администратор"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
						</Grid>
					</Border>

					<Border Background="{DynamicResource Task}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="6" Padding="12">
						<Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
							<Border Width="40" Height="40" Background="#DDF4E7" CornerRadius="20">
								<TextBlock Text="МП" Foreground="#39956C" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
								<TextBlock Text="Мария Петрова" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}"/>
								<TextBlock Text="Дизайнер" FontSize="12"
                                           Foreground="{DynamicResource Gray}"/>
							</StackPanel>
							<TextBlock Grid.Column="2" Text="Участник" Foreground="#39956C"
                                       VerticalAlignment="Center"/>
						</Grid>
					</Border>

					<Border Background="{DynamicResource Task}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="6" Padding="12">
						<Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
							<Border Width="40" Height="40" Background="#DDEBFA" CornerRadius="20">
								<TextBlock Text="ИС" Foreground="#367DC8" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
								<TextBlock Text="Иван Смирнов" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}"/>
								<TextBlock Text="Разработчик" FontSize="12"
                                           Foreground="{DynamicResource Gray}"/>
							</StackPanel>
							<TextBlock Grid.Column="2" Text="Участник" Foreground="#39956C"
                                       VerticalAlignment="Center"/>
						</Grid>
					</Border>
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
